# Copia este archivo como .env.local y completa los valores

# PostgreSQL (Neon) -> console.neon.tech -> Connection string
# Ejemplo: postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/sena_almacen?sslmode=require
DATABASE_URL=postgresql://usuario:clave@host/sena_almacen

# Opcional: "require" fuerza SSL, "disable" lo apaga (solo Postgres local)
# PGSSL=require

# Clave para firmar la sesión (inventa una larga y aleatoria)
AUTH_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Solo para `npm run seed` (crear el administrador inicial)
ADMIN_USER=admin
ADMIN_PIN=1234
ADMIN_NOMBRE=Administrador SENA
